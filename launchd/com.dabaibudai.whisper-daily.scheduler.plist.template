<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dabaibudai.whisper-daily.scheduler</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__HOME__/Library/Application Support/WhisperDaily/runtime/schedule-controller.zsh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Application Support/WhisperDaily/records/logs/scheduler.out</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Application Support/WhisperDaily/records/logs/scheduler.err</string>
</dict>
</plist>
